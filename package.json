{
  "name": "douglasfritz-github-io",
  "version": "0.0.0",
  "private": true,
  "description": "Browser code and tests for Douglas Fritz's Quarto research website",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "data:fixture": "Rscript scripts/build_data.R --publications tests/fixtures/journal_articles.csv --talks tests/fixtures/conferences.csv",
    "vendor:map": "node scripts/vendor-map.mjs",
    "test:unit": "node --test \"tests/js/**/*.test.mjs\"",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "http-server": "14.1.1",
    "js-yaml": "4.1.1",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3"
  }
}
